{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CineVault",
  "version": "1.1.0",
  "identifier": "app.cinevault.desktop",
  "build": {
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CineVault",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#121211",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CineVault",
    "copyright": "Copyright (c) CineVault contributors",
    "category": "Video",
    "shortDescription": "Fast movie and TV library manager.",
    "longDescription": "CineVault scans media folders, identifies titles, writes Kodi, Jellyfin and Emby NFO and artwork files, and renames folders from templates with undo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
