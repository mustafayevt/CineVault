<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  A small scraper for a made-up series index, written for CineVault's tests: search, show
  details with an episode guide link, an episode list and episode details. The site address comes
  from the add-on setting "baseurl".
-->
<scraper framework="1.1" date="2025-01-01" name="Sample Series Index" content="tvshows" language="en">

  <CreateSearchUrl dest="3">
    <RegExp input="$$1" output="&lt;url&gt;$INFO[baseurl]/series/search?q=\1&lt;/url&gt;" dest="3">
      <expression noclean="1"/>
    </RegExp>
  </CreateSearchUrl>

  <GetSearchResults dest="8">
    <RegExp input="$$5" output="&lt;results&gt;\1&lt;/results&gt;" dest="8">
      <RegExp input="$$1" output="&lt;entity&gt;&lt;title&gt;\2&lt;/title&gt;&lt;year&gt;\3&lt;/year&gt;&lt;id&gt;\1&lt;/id&gt;&lt;url&gt;$INFO[baseurl]/series/\1&lt;/url&gt;&lt;/entity&gt;" dest="5">
        <expression repeat="yes"><![CDATA[<li class="hit" data-id="(\d+)"><a[^>]*>(.*?)</a> \((\d{4})\)]]></expression>
      </RegExp>
      <expression noclean="1"/>
    </RegExp>
  </GetSearchResults>

  <!-- $$1 is the show page, $$2 the show ID. The episode guide is the episodes page of the ID. -->
  <GetDetails dest="3">
    <RegExp input="$$5" output="&lt;details&gt;\1&lt;id&gt;$$2&lt;/id&gt;&lt;episodeguide&gt;&lt;url&gt;$INFO[baseurl]/series/$$2/episodes&lt;/url&gt;&lt;/episodeguide&gt;&lt;/details&gt;" dest="3">
      <RegExp input="$$1" output="&lt;title&gt;\1&lt;/title&gt;" dest="5">
        <expression><![CDATA[<h1 class="name">(.*?)</h1>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;premiered&gt;\1&lt;/premiered&gt;" dest="5+">
        <expression><![CDATA[datetime="(\d{4}-\d{2}-\d{2})"]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;status&gt;\1&lt;/status&gt;" dest="5+">
        <expression><![CDATA[<span class="status">(.*?)</span>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;studio&gt;\1&lt;/studio&gt;" dest="5+">
        <expression><![CDATA[<span class="network">(.*?)</span>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;genre&gt;\1&lt;/genre&gt;" dest="5+">
        <expression repeat="yes"><![CDATA[<li class="g">(.*?)</li>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;plot&gt;\1&lt;/plot&gt;" dest="5+">
        <expression><![CDATA[<p class="plot">(.*?)</p>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;thumb aspect=&quot;poster&quot;&gt;\1&lt;/thumb&gt;" dest="5+">
        <expression noclean="1"><![CDATA[<img class="poster" src="(.*?)"]]></expression>
      </RegExp>
      <expression noclean="1"/>
    </RegExp>
  </GetDetails>

  <!-- $$1 is the episodes page. -->
  <GetEpisodeList dest="8">
    <RegExp input="$$5" output="&lt;episodeguide&gt;\1&lt;/episodeguide&gt;" dest="8">
      <RegExp input="$$1" output="&lt;episode&gt;&lt;id&gt;\1&lt;/id&gt;&lt;season&gt;\2&lt;/season&gt;&lt;epnum&gt;\3&lt;/epnum&gt;&lt;title&gt;\4&lt;/title&gt;&lt;aired&gt;\5&lt;/aired&gt;&lt;url&gt;$INFO[baseurl]/episode/\1&lt;/url&gt;&lt;/episode&gt;" dest="5">
        <expression repeat="yes" fixchars="4"><![CDATA[<tr data-ep="(\d+)"><td class="s">(\d+)</td><td class="e">(\d+)</td><td class="t">(.*?)</td><td class="a">(.*?)</td></tr>]]></expression>
      </RegExp>
      <expression noclean="1"/>
    </RegExp>
  </GetEpisodeList>

  <!-- $$1 is the episode page, $$2 the episode ID. -->
  <GetEpisodeDetails dest="3">
    <RegExp input="$$5" output="&lt;details&gt;\1&lt;id&gt;$$2&lt;/id&gt;&lt;/details&gt;" dest="3">
      <RegExp input="$$1" output="&lt;title&gt;\1&lt;/title&gt;" dest="5">
        <expression><![CDATA[<h2 class="ep">(.*?)</h2>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;plot&gt;\1&lt;/plot&gt;" dest="5+">
        <expression><![CDATA[<p class="plot">(.*?)</p>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;runtime&gt;\1&lt;/runtime&gt;" dest="5+">
        <expression><![CDATA[<span class="runtime">(.*?)</span>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;rating&gt;\1&lt;/rating&gt;" dest="5+">
        <expression><![CDATA[<span class="rating">(.*?)</span>]]></expression>
      </RegExp>
      <expression noclean="1"/>
    </RegExp>
  </GetEpisodeDetails>
</scraper>
