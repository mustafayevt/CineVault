<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  A small scraper for a made-up film index, written for CineVault's tests. It uses the ScraperXML
  functions the interpreter supports: NfoUrl, CreateSearchUrl, GetSearchResults, GetDetails and a
  chained helper function. The site address comes from the add-on setting "baseurl".
-->
<scraper framework="1.1" date="2025-01-01" name="Sample Film Index" content="movies" language="en">

  <!-- $$1 is the text of an NFO file. A pointer to the index, or an IMDb link, names a film. -->
  <NfoUrl dest="3">
    <RegExp input="$$1" output="&lt;url&gt;$INFO[baseurl]/film/\1&lt;/url&gt;&lt;id&gt;\1&lt;/id&gt;" dest="3">
      <expression><![CDATA[film-index\.example/film/(\d+)]]></expression>
    </RegExp>
    <RegExp input="$$1" output="&lt;url&gt;$INFO[baseurl]/imdb/\1&lt;/url&gt;" dest="3+">
      <expression><![CDATA[imdb\.com/title/(tt\d+)]]></expression>
    </RegExp>
  </NfoUrl>

  <!-- $$1 is the URL-encoded title, $$2 the year (or empty). -->
  <CreateSearchUrl dest="3">
    <RegExp input="$$1" output="&lt;url&gt;$INFO[baseurl]/search?q=\1$$4&lt;/url&gt;" dest="3">
      <RegExp input="$$2" output="&amp;y=\1" dest="4">
        <expression><![CDATA[^(\d{4})$]]></expression>
      </RegExp>
      <expression noclean="1"/>
    </RegExp>
  </CreateSearchUrl>

  <!-- $$1 is the search page. -->
  <GetSearchResults dest="8">
    <RegExp input="$$5" output="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;results&gt;\1&lt;/results&gt;" dest="8">
      <RegExp input="$$1" output="&lt;entity&gt;&lt;title&gt;\2&lt;/title&gt;&lt;year&gt;\3&lt;/year&gt;&lt;id&gt;\1&lt;/id&gt;&lt;url&gt;$INFO[baseurl]/film/\1&lt;/url&gt;&lt;/entity&gt;" dest="5">
        <expression repeat="yes"><![CDATA[<li class="hit" data-id="(\d+)"><a[^>]*>(.*?)</a> \((\d{4})\)]]></expression>
      </RegExp>
      <expression noclean="1"/>
    </RegExp>
  </GetSearchResults>

  <!-- $$1 is the film page, $$2 the film ID. -->
  <GetDetails dest="3">
    <RegExp input="$$5" output="&lt;details&gt;\1&lt;id&gt;$$2&lt;/id&gt;&lt;chain function=&quot;GetTagline&quot;&gt;$$2&lt;/chain&gt;&lt;/details&gt;" dest="3">
      <RegExp input="$$1" output="&lt;title&gt;\1&lt;/title&gt;" dest="5">
        <expression><![CDATA[<h1 class="title">(.*?)\s*<span]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;year&gt;\1&lt;/year&gt;" dest="5+">
        <expression><![CDATA[class="year">\((\d{4})\)]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;originaltitle&gt;\1&lt;/originaltitle&gt;" dest="5+">
        <expression><![CDATA[<p class="orig">(.*?)</p>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;runtime&gt;\1&lt;/runtime&gt;" dest="5+">
        <expression><![CDATA[class="runtime">(.*?)</span>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;mpaa&gt;\1&lt;/mpaa&gt;" dest="5+">
        <expression><![CDATA[class="rated">(.*?)<]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;ratings&gt;&lt;rating name=&quot;sample&quot; max=&quot;10&quot; default=&quot;true&quot;&gt;&lt;value&gt;\2&lt;/value&gt;&lt;votes&gt;\1&lt;/votes&gt;&lt;/rating&gt;&lt;/ratings&gt;" dest="5+">
        <expression><![CDATA[data-votes="([\d,]+)">([\d.]+)<]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;genre&gt;\1&lt;/genre&gt;" dest="5+">
        <expression repeat="yes"><![CDATA[<li class="g">(.*?)</li>]]></expression>
      </RegExp>
      <!-- The plot keeps its line breaks and decodes entities, unless the user asks for plain text. -->
      <RegExp input="$$1" output="&lt;plot&gt;\1&lt;/plot&gt;" dest="5+">
        <expression fixchars="1"><![CDATA[<div class="plot">(.*?)</div>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;director&gt;\1&lt;/director&gt;" dest="5+">
        <expression><![CDATA[<a class="director">(.*?)</a>]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;actor&gt;&lt;name&gt;\1&lt;/name&gt;&lt;role&gt;\2&lt;/role&gt;&lt;thumb&gt;\3&lt;/thumb&gt;&lt;/actor&gt;" dest="5+">
        <expression repeat="yes" noclean="3"><![CDATA[<li class="c"><span class="n">(.*?)</span> as <span class="r">(.*?)</span> <img src="(.*?)">]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;thumb aspect=&quot;poster&quot;&gt;\1&lt;/thumb&gt;" dest="5+">
        <expression noclean="1"><![CDATA[<img class="poster" src="(.*?)"]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;fanart&gt;&lt;thumb&gt;\1&lt;/thumb&gt;&lt;/fanart&gt;" dest="5+">
        <expression noclean="1"><![CDATA[<meta property="bg" content="(.*?)">]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;trailer&gt;\1&lt;/trailer&gt;" dest="5+">
        <expression noclean="1"><![CDATA[<a class="trailer" href="(.*?)">]]></expression>
      </RegExp>
      <RegExp input="$$1" output="&lt;uniqueid type=&quot;imdb&quot;&gt;\1&lt;/uniqueid&gt;" dest="5+">
        <expression><![CDATA[imdb\.com/title/(tt\d+)/]]></expression>
      </RegExp>
      <expression noclean="1"/>
    </RegExp>
  </GetDetails>

  <!-- Called through the chain element in the details: $$1 is the chain's text (the film ID). -->
  <GetTagline dest="3">
    <RegExp input="$$1" output="&lt;details&gt;&lt;tagline&gt;Film number \1&lt;/tagline&gt;&lt;/details&gt;" dest="3">
      <expression>(\d+)</expression>
    </RegExp>
  </GetTagline>
</scraper>
